LODESTA_APP_ORIGIN=http://localhost:4330
# required in deployed environments for operator/admin APIs
LODESTA_ADMIN_TOKEN=
# Shared only between Railway and the scheduled recovery Worker.
LODESTA_RECOVERY_WATCHDOG_URL=https://lodesta.example/api/site-agent/maintenance/
LODESTA_RECOVERY_WATCHDOG_TOKEN=
# optional local switch to exercise production-style auth gates in development
LODESTA_REQUIRE_AUTH=false
LODESTA_CRAWL_FIXTURE_TOKEN=
LODESTA_HASH_SECRET=
# Versioned HMAC keys for deterministic, retry-safe private preview secrets.
# Example shape only; use random values of at least 32 characters.
LODESTA_PREVIEW_HMAC_KEYS={"v1":"replace-with-a-random-preview-hmac-key"}
LODESTA_PREVIEW_HMAC_ACTIVE_KEY_VERSION=v1
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SESSION_POOLER_URL=
# Operator-only direct/session-pooler Postgres URL used only for the pre-cutover pg_dump.
LODESTA_CUTOVER_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dedicated non-production owner-journey canary. The script refuses to run
# unless the explicit non-production confirmation is true.
LODESTA_OWNER_CANARY_CONFIRMED_NONPRODUCTION=false
LODESTA_OWNER_CANARY_ORIGIN=http://localhost:4330
LODESTA_OWNER_CANARY_SOURCE_URL=https://canary-source.example
LODESTA_OWNER_CANARY_EMAIL=owner-canary@example.com
LODESTA_OWNER_CANARY_BUILD_TIMEOUT_MS=2700000
LODESTA_OWNER_CANARY_EDIT_TIMEOUT_MS=1800000
# Hosted identities set one explicit role: web, site-authoring-worker, or release.
# Local commands clear the role and force the local repository.
LODESTA_EXECUTION_ROLE=
LODESTA_REPOSITORY=
# Stable secret shared only by the coordinated release and rollback workflows.
LODESTA_MAINTENANCE_LEASE_OWNER=
LODESTA_ASSET_STORAGE=
RESEND_API_KEY=
LODESTA_REPORT_EMAIL_TIMEOUT_MS=5000
LODESTA_WORKFLOW_TIMEOUT_MS=5000
LODESTA_WORKER_IDLE_MS=1000
LODESTA_INQUIRY_AI_RATE_LIMIT_PER_SITE_PER_HOUR=20
OPENAI_API_KEY=
# Optional override; Visual Quality defaults to gpt-5.6-sol. Without OPENAI_API_KEY,
# the advisory section is retained with unknown coverage and does not affect assessment success.
LODESTA_VISUAL_ASSESSMENT_MODEL=
# Opt-in only; normal CI uses deterministic mocked evaluator responses.
VISUAL_QUALITY_LIVE_CONFORMANCE=false
# Optional until the website manager API provider is switched to OpenRouter.
OPENROUTER_API_KEY=
# Optional. Enables Google CrUX mobile field metrics in website assessments;
# assessments fall back to three-run browser lab medians when absent or unavailable.
GOOGLE_CRUX_API_KEY=
# Optional comma-separated public URLs for hosted-site Agent Readiness verification.
AGENT_READY_SITE_URLS=
# External isitagentready.com conformance verification is opt-in and never persists assessment results.
AGENT_READY_EXTERNAL_SCAN=false
LODESTA_PROSPECT_REPORT_SCAN_DAILY_CAP=50
LODESTA_PROSPECT_REPORT_SCAN_CONCURRENCY=2
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FALLBACK_ORIGIN=customers.lodesta.example
# Agentic site workspace
LODESTA_SANDBOX_BLUE_URL=https://lodesta-site-sandbox-v1.example.workers.dev
LODESTA_SANDBOX_BLUE_TOKEN=
LODESTA_SANDBOX_GREEN_URL=https://lodesta-site-sandbox-green.example.workers.dev
LODESTA_SANDBOX_GREEN_TOKEN=
# Optional local overrides. By default npm run dev creates distinct gitignored
# credentials, deploys the inactive development slot, canaries it, and promotes it.
LODESTA_DEV_SANDBOX_BLUE_TOKEN=
LODESTA_DEV_SANDBOX_GREEN_TOKEN=
# Exact Git commit uploaded by the approval-protected production release.
LODESTA_RELEASE_GIT_SHA=
LODESTA_ARTIFACT_STORAGE=local
LODESTA_ARTIFACT_BROKER_URL=https://lodesta-artifact-broker-v1.example.workers.dev
LODESTA_ARTIFACT_BROKER_TOKEN=
# Operator-only direct R2 credentials; never configure these on Railway or either Worker.
LODESTA_R2_ACCOUNT_ID=
LODESTA_R2_ENDPOINT=
LODESTA_R2_AUDIT_ACCESS_KEY_ID=
LODESTA_R2_AUDIT_SECRET_ACCESS_KEY=
LODESTA_R2_MAINTENANCE_ACCESS_KEY_ID=
LODESTA_R2_MAINTENANCE_SECRET_ACCESS_KEY=
LODESTA_ARTIFACT_BUCKET=lodesta-agentic-sites-v1
LODESTA_WORKSPACE_BUCKET=lodesta-workspace-backups-v1
# Operator-only evidence archive access. Never configure this bucket or credential on Railway or Workers.
LODESTA_EVIDENCE_STORAGE=local
LODESTA_EVIDENCE_R2_ACCESS_KEY_ID=
LODESTA_EVIDENCE_R2_SECRET_ACCESS_KEY=
LODESTA_EVIDENCE_BUCKET=lodesta-authoring-evidence-v1
LODESTA_LOCAL_EVIDENCE_ROOT=
LODESTA_SANDBOX_MEMORY_GIB=6
LODESTA_CLOUDFLARE_MEMORY_USD_PER_GIB_SECOND=
LODESTA_SITE_AGENT_PROVIDER=
LODESTA_SITE_AGENT_MODEL=
# Optional operator-only lower ceiling for site-agent runs; never raises the built-in limit.
LODESTA_SITE_AGENT_MAX_COST_USD=
LODESTA_INGESTION_MODEL=
