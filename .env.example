LODESTA_APP_ORIGIN=http://localhost:4330
# required in deployed environments for operator/admin APIs
LODESTA_ADMIN_TOKEN=
# optional Supabase Auth user ID allowed to view admin-only pages such as /outbound
LODESTA_ADMIN_USER_ID=
# optional local switch to exercise production-style auth gates in development
LODESTA_REQUIRE_AUTH=false
LODESTA_CRAWL_FIXTURE_TOKEN=
LODESTA_HASH_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SESSION_POOLER_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
LODESTA_REPOSITORY=
LODESTA_ASSET_STORAGE=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
LODESTA_WORKFLOW_TIMEOUT_MS=5000
GROQ_API_KEY=
GROQ_INQUIRY_AI_MODEL=openai/gpt-oss-120b
GROQ_INQUIRY_AI_TIMEOUT_MS=8000
LODESTA_INQUIRY_AI_RATE_LIMIT_PER_SITE_PER_HOUR=20
# Production AI triage stays disabled until Groq data controls/ZDR and disclosures are verified.
LODESTA_GROQ_ZDR_CONFIRMED=false
GOOGLE_PLACES_API_KEY=
# link_only | embed. Embed mode requires a browser-safe, HTTP-referrer-restricted public key.
LODESTA_LOCATION_MAP_MODE=link_only
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Browser key for the Places UI Kit trust module (referrer-restricted; falls back to the embed key).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Daily ceiling on tokenized previews that render the Places UI Kit module (link-only past it).
LODESTA_PREVIEW_PROOF_DAILY_CAP=500
# off | fixture_only | operator_allowlist | auto_body_canonical | supported_verticals_canonical | all_canonical
GENERATED_SITE_V2_MODE=all_canonical
# Required for URL-based V2 generations in operator_allowlist mode.
GENERATED_SITE_V2_ALLOWLIST_HOSTS=
# off | fixture_only | operator_allowlist | all_new_generations
GENERATED_SITE_V3_MODE=fixture_only
# Required for URL-based V3 generations in operator_allowlist mode.
GENERATED_SITE_V3_ALLOWLIST_HOSTS=
# Required in addition to GENERATED_SITE_V3_MODE=all_new_generations before V3 can become the default.
GENERATED_SITE_V3_CONFIRM_ALL_NEW_GENERATIONS=
OPENAI_API_KEY=
LODESTA_ASSET_LIBRARY_IMAGE_ESTIMATE_USD=0.08
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FALLBACK_ORIGIN=customers.lodesta.example
