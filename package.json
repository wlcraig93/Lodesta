{
  "name": "lodesta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p ${PORT:-4330} -H ${HOST:-127.0.0.1}",
    "dev:worker": "node --import tsx workers/runner.ts work",
    "dev:raw": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "smoke": "bash scripts/smoke.sh",
    "smoke:dev": "bash scripts/smoke.sh --start-server",
    "cli": "node scripts/lodesta.mjs",
    "access:platform-admin": "node --env-file=.env.local --import tsx scripts/manage-platform-admin.ts",
    "worker": "node --import tsx workers/runner.ts",
    "runtime:promote": "node --env-file=.env.local --import tsx scripts/promote-site-runtime.ts",
    "audit:artifact-blobs": "node --env-file=.env.local --import tsx scripts/audit-artifact-blobs.ts",
    "audit:sandbox-cost": "node --env-file=.env.local --import tsx scripts/audit-sandbox-cost.ts",
    "configure:r2-lifecycle": "node --env-file=.env.local --import tsx scripts/configure-r2-lifecycle.ts",
    "deploy:artifact-broker": "wrangler deploy --config workers/artifact-broker/wrangler.jsonc",
    "deploy:recovery-watchdog": "wrangler deploy --config workers/recovery-watchdog/wrangler.jsonc",
    "deploy:site-sandbox": "wrangler deploy --config workers/site-sandbox/wrangler.jsonc",
    "maintenance:workspace-cutover": "node --env-file=.env.local --import tsx scripts/workspace-cutover-lease.ts",
    "snapshot:site-v3-database": "node --env-file=.env.local --import tsx scripts/snapshot-site-v3-database.ts",
    "migrate:workspace-blobs": "node --env-file=.env.local --import tsx scripts/migrate-workspace-blobs.ts",
    "cleanup:workspace-rollback-copies": "node --env-file=.env.local --import tsx scripts/cleanup-workspace-rollback-copies.ts",
    "retire:workspace-rollback-after-site-v3": "node --env-file=.env.local --import tsx scripts/retire-workspace-rollback-after-site-v3.ts",
    "cleanup:experimental": "node --env-file=.env.local --import tsx scripts/cleanup-experimental-site.ts",
    "reclassify:site-v3": "node --env-file=.env.local --import tsx scripts/reclassify-prelaunch-site-v3.ts",
    "reconcile:site-v3-traces": "node --env-file=.env.local --import tsx scripts/reconcile-cutover-trace-payloads.ts",
    "cutover:site-v3": "node --env-file=.env.local --import tsx scripts/site-v3-cutover.ts",
    "quality:site": "node --env-file=.env.local --import tsx scripts/site-quality.ts",
    "quality:edit-battery": "node --env-file=.env.local --import tsx scripts/run-site-edit-battery.ts",
    "install:browsers": "node --import tsx scripts/install-browsers.ts",
    "verify:deployment-config": "node --import tsx scripts/verify-deployment-config.ts",
    "verify:recovery-watchdog": "node --import tsx scripts/verify-recovery-watchdog.ts",
    "verify:dev-crawl": "node --import tsx scripts/verify-dev-crawl.mjs",
    "verify:business-data-normalization": "node --import tsx scripts/verify-business-data-normalization.ts",
    "verify:site-v3-cutover": "node --import tsx scripts/verify-site-v3-cutover.ts",
    "verify:site-v3-walking-skeleton": "node --env-file=.env.local --import tsx scripts/verify-site-v3-walking-skeleton.ts",
    "verify:site-ingestion-v2": "node --import tsx scripts/verify-generation-ingestion-v2.ts",
    "verify:artifact-storage-boundaries": "node --import tsx scripts/verify-artifact-storage-boundaries.ts",
    "verify:r2-maintenance-access": "node --env-file=.env.local --import tsx scripts/verify-r2-maintenance-access.ts",
    "verify:render-browser": "node --import tsx scripts/verify-agentic-render-browser.ts",
    "verify:retained-site-v4": "node --env-file=.env.local --import tsx scripts/verify-retained-site-v4.ts",
    "verify:prospect-reports": "node --import tsx scripts/verify-prospect-reports.ts",
    "verify:stripe-webhook": "node --import tsx scripts/verify-stripe-webhook.ts",
    "verify:supabase": "node --import tsx scripts/verify-supabase.ts",
    "verify:site-sandbox-v1": "node --env-file=.env.local --import tsx scripts/verify-site-sandbox-v1.ts",
    "verify:agentic-site-platform-v1": "node --import tsx scripts/verify-agentic-site-platform-v1.ts",
    "verify:site-agent-manager-v3": "node --import tsx scripts/verify-site-agent-manager-v3.ts",
    "verify:site-agent-workspace": "node --import tsx scripts/verify-site-agent-workspace.ts",
    "verify:owner-workspace": "node --import tsx scripts/verify-owner-workspace.ts",
    "verify:account-access": "node --import tsx scripts/verify-account-access.ts",
    "verify:product-typography": "node --import tsx scripts/verify-product-typography.ts",
    "verify:trusted-runtime": "node --import tsx scripts/verify-trusted-runtime.ts",
    "verify:agentic-site-walking-skeleton": "node --env-file=.env.local --import tsx scripts/verify-agentic-site-walking-skeleton.ts",
    "verify:agent-ready-sites": "node --import tsx scripts/verify-agent-ready-sites.ts",
    "verify:agentic-live-experiment": "node --env-file=.env.local --import tsx scripts/run-agentic-live-acceptance.ts",
    "verify:agentic-architecture": "node --import tsx scripts/verify-agentic-architecture.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@cloudflare/sandbox": "^0.12.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "htmlparser2": "^12.0.0",
    "next": "^15.0.0",
    "openai": "^6.48.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "wrangler": "^4.112.0"
  }
}
