{
  "name": "lodesta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p ${PORT:-4330} -H ${HOST:-127.0.0.1}",
    "dev:worker": "node --import tsx workers/runner.ts work",
    "dev:raw": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "smoke": "bash scripts/smoke.sh",
    "smoke:dev": "bash scripts/smoke.sh --start-server",
    "cli": "node scripts/lodesta.mjs",
    "worker": "node --import tsx workers/runner.ts",
    "runtime:promote": "node --env-file=.env.local --import tsx scripts/promote-site-runtime.ts",
    "install:browsers": "node --import tsx scripts/install-browsers.ts",
    "verify:deployment-config": "node --import tsx scripts/verify-deployment-config.ts",
    "verify:dev-crawl": "node --import tsx scripts/verify-dev-crawl.mjs",
    "verify:render-browser": "node --import tsx scripts/verify-agentic-render-browser.ts",
    "verify:prospect-reports": "node --import tsx scripts/verify-prospect-reports.ts",
    "verify:stripe-webhook": "node --import tsx scripts/verify-stripe-webhook.ts",
    "verify:supabase": "node --import tsx scripts/verify-supabase.ts",
    "verify:site-sandbox-v1": "node --env-file=.env.local --import tsx scripts/verify-site-sandbox-v1.ts",
    "verify:agentic-site-platform-v1": "node --import tsx scripts/verify-agentic-site-platform-v1.ts",
    "verify:site-agent-manager-v2": "node --import tsx scripts/verify-site-agent-manager-v2.ts",
    "verify:trusted-runtime": "node --import tsx scripts/verify-trusted-runtime.ts",
    "verify:agentic-site-walking-skeleton": "node --env-file=.env.local --import tsx scripts/verify-agentic-site-walking-skeleton.ts",
    "verify:agentic-live-experiment": "node --env-file=.env.local --import tsx scripts/run-agentic-live-acceptance.ts",
    "verify:agentic-architecture": "node --import tsx scripts/verify-agentic-architecture.ts"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "htmlparser2": "^12.0.0",
    "next": "^15.0.0",
    "openai": "^6.48.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "wrangler": "^4.112.0"
  }
}
