{
  "name": "lodesta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:inspect": "node scripts/dev-inspect.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:worker": "node --import tsx workers/runner.ts work",
    "dev:raw": "LODESTA_DEV_SANDBOX=0 LODESTA_SANDBOX_URL= LODESTA_SANDBOX_TOKEN= LODESTA_SANDBOX_IMAGE_DIGEST= next dev --turbopack",
    "build": "next build --turbopack",
    "start": "node scripts/start-local.mjs",
    "start:production": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "smoke": "bash scripts/smoke.sh",
    "smoke:dev": "bash scripts/smoke.sh --start-server",
    "cli": "node scripts/lodesta.mjs",
    "access:platform-admin": "node --env-file=.env.local --import tsx scripts/manage-platform-admin.ts",
    "access:external-authoring": "node --env-file=.env.local --import tsx scripts/manage-external-authoring-credentials.ts",
    "cutover:external-authoring-previews": "node --env-file=.env.local --import tsx scripts/cutover-external-authoring-previews.ts",
    "worker": "node --import tsx workers/runner.ts",
    "runtime:promote": "node --env-file=.env.local --import tsx scripts/promote-site-runtime.ts",
    "audit:artifact-blobs": "node --env-file=.env.local --import tsx scripts/audit-artifact-blobs.ts",
    "audit:sandbox-cost": "node --env-file=.env.local --import tsx scripts/audit-sandbox-cost.ts",
    "configure:r2-lifecycle": "node --env-file=.env.local --import tsx scripts/configure-r2-lifecycle.ts",
    "deploy:artifact-broker": "wrangler deploy --config workers/artifact-broker/wrangler.jsonc",
    "deploy:recovery-watchdog": "wrangler deploy --config workers/recovery-watchdog/wrangler.jsonc",
    "deploy:site-sandbox": "wrangler deploy --config workers/site-sandbox/wrangler.jsonc --strict --containers-rollout=immediate",
    "deploy:site-sandbox:dev": "node --import tsx scripts/deploy-site-sandbox-dev.ts",
    "ensure:site-sandbox:dev": "node --import tsx scripts/ensure-site-sandbox-dev.ts",
    "canary:owner-journey": "node --env-file=.env.local --import tsx scripts/canary-owner-journey.ts",
    "generate:site-sandbox-manifest": "node --import tsx scripts/generate-site-sandbox-manifest.ts",
    "maintenance:site-authoring": "node --import tsx scripts/site-authoring-maintenance.ts",
    "maintenance:reset-prelaunch-site-authoring": "node --env-file=.env.local --import tsx scripts/reset-prelaunch-site-authoring.ts",
    "install:browsers": "node --import tsx scripts/install-browsers.ts",
    "verify:deployment-config": "node --import tsx scripts/verify-deployment-config.ts",
    "verify:development-sandbox": "node --import tsx scripts/verify-development-sandbox.ts",
    "verify:postcss-security": "node --import tsx scripts/verify-postcss-security.ts",
    "verify:recovery-watchdog": "node --import tsx scripts/verify-recovery-watchdog.ts",
    "verify:release-evidence": "node --import tsx scripts/verify-release-evidence.ts",
    "verify:dev-crawl": "node --import tsx scripts/verify-dev-crawl.mjs",
    "verify:business-data-normalization": "node --import tsx scripts/verify-business-data-normalization.ts",
    "verify:architecture": "node --import tsx scripts/verify-site-authoring-architecture.ts",
    "verify:database": "node --import tsx scripts/verify-supabase.ts",
    "verify:database-live": "node --env-file=.env.local --import tsx scripts/verify-database-migrations.ts",
    "verify:authoring": "node --import tsx scripts/verify-site-authoring-platform.ts && node --import tsx scripts/verify-authority-flows.ts",
    "verify:external-authoring": "LODESTA_REPOSITORY=local node --import tsx scripts/verify-external-authoring.ts",
    "verify:external-authoring-connectivity": "node --env-file=.env.local --import tsx scripts/spike-external-authoring-connectivity.ts",
    "verify:runtime": "node --import tsx scripts/verify-trusted-runtime.ts && node --import tsx scripts/verify-artifact-storage-boundaries.ts",
    "verify:account-setup-domain": "node --import tsx scripts/verify-account-access.ts && node --import tsx scripts/verify-owner-workspace.ts && node --import tsx scripts/verify-website-setups.ts && node --import tsx scripts/verify-site-disposition.ts",
    "verify:acquisition": "node --import tsx scripts/verify-prospect-reports.ts && node --import tsx scripts/verify-prospect-research.ts",
    "verify:marketing-acquisition": "node --import tsx scripts/verify-marketing-acquisition.ts",
    "verify:website-assessments": "node --import tsx scripts/verify-website-assessments.ts",
    "verify:visual-quality": "node --import tsx scripts/verify-visual-quality.ts",
    "calibrate:website-assessments": "node --import tsx scripts/calibrate-website-assessments.ts",
    "summarize:generation-quality-benchmark": "node --import tsx scripts/summarize-generation-quality-benchmark.ts",
    "verify:generation-quality-benchmark": "node --import tsx scripts/verify-generation-quality-benchmark.ts",
    "run:model-bakeoff": "LODESTA_DEV_SANDBOX=1 node --env-file=.env.local --import tsx scripts/run-model-bakeoff.ts",
    "probe:openrouter-anthropic-messages": "node --env-file=.env.local --import tsx scripts/probe-openrouter-anthropic-messages.ts",
    "probe:openrouter-parameters": "node --env-file=.env.local --import tsx scripts/probe-openrouter-parameter-isolation.ts",
    "probe:openrouter-warm-cache": "node --env-file=.env.local --import tsx scripts/probe-openrouter-warm-cache.ts",
    "probe:site-agent-cache": "node --env-file=.env.local --import tsx scripts/probe-site-agent-cache.ts",
    "validate:site-agent-sol": "LODESTA_DEV_SANDBOX=1 node --env-file=.env.local --import tsx scripts/validate-site-agent-sol.ts",
    "verify:model-bakeoff": "node --import tsx scripts/verify-model-bakeoff.ts",
    "verify:generation-ingestion": "node --import tsx scripts/verify-generation-ingestion.ts",
    "verify:health": "node --import tsx scripts/verify-health.ts",
    "verify:artifact-storage-boundaries": "node --import tsx scripts/verify-artifact-storage-boundaries.ts",
    "verify:r2-maintenance-access": "node --env-file=.env.local --import tsx scripts/verify-r2-maintenance-access.ts",
    "verify:r2-lifecycle": "node --env-file=.env.local --import tsx scripts/verify-r2-lifecycle.ts",
    "verify:render-browser": "node --import tsx scripts/verify-site-authoring-render-browser.ts",
    "verify:retained-site": "node --env-file=.env.local --import tsx scripts/verify-retained-site.ts",
    "verify:site-sandbox-local": "node --import tsx scripts/verify-site-sandbox-local.ts",
    "verify:site-sandbox-deployed": "node --import tsx scripts/verify-site-sandbox-deployed.ts",
    "verify:site-sandbox-manifest": "node --import tsx scripts/verify-site-sandbox-manifest.ts",
    "verify:site-agent-manager": "node --import tsx scripts/verify-site-agent-manager.ts",
    "verify:media-authoring": "node --import tsx scripts/verify-media-authoring.ts",
    "verify:site-intent-persistence": "node --import tsx scripts/verify-site-intent-persistence.ts",
    "verify:site-agent-workspace": "node --import tsx scripts/verify-site-agent-workspace.ts",
    "verify:owner-chat": "node --import tsx scripts/verify-owner-chat.ts",
    "verify:agent-activity": "node --import tsx scripts/verify-agent-activity.ts",
    "verify:product-ui": "node --import tsx scripts/verify-product-ui.ts",
    "verify:product-typography": "node --import tsx scripts/verify-product-typography.ts",
    "verify:owner-journey-canary": "node --import tsx scripts/verify-owner-journey-canary.ts",
    "verify:trusted-runtime": "node --import tsx scripts/verify-trusted-runtime.ts",
    "verify:static": "npm run verify:postcss-security && npm run typecheck && npm run build && npm run verify:architecture && npm run verify:database && npm run verify:authoring && npm run verify:account-setup-domain && npm run verify:acquisition && npm run verify:external-authoring && npm run verify:recovery-watchdog && npm run verify:health && npm run verify:deployment-config && npm run verify:release-evidence && npm run verify:site-agent-manager && npm run verify:site-agent-workspace && npm run verify:model-bakeoff && npm run verify:product-ui && npm run verify:owner-journey-canary",
    "verify:browser": "npm run verify:generation-ingestion && npm run verify:render-browser && npm run verify:trusted-runtime && npm run verify:marketing-acquisition",
    "verify:sandbox": "npm run verify:site-sandbox-manifest && npm run verify:development-sandbox && npm run verify:site-sandbox-local",
    "verify:preflight": "npm run verify:static && npm run verify:browser && npm run verify:sandbox",
    "verify:analytics": "node --import tsx scripts/verify-analytics.ts",
    "maintenance:analytics-retention": "node --env-file=.env.local --import tsx scripts/prune-analytics-events.ts",
    "verify:agent-ready-sites": "node --import tsx scripts/verify-agent-ready-sites.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@cloudflare/sandbox": "^0.12.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "axe-core": "4.12.1",
    "htmlparser2": "^12.0.0",
    "next": "^15.5.21",
    "openai": "^6.48.0",
    "playwright": "^1.60.0",
    "postcss": "8.5.23",
    "postcss-value-parser": "^4.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "wrangler": "^4.112.0"
  }
}
