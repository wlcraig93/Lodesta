{
  "name": "lodesta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p ${PORT:-4330} -H ${HOST:-127.0.0.1}",
    "dev:worker": "node --import tsx workers/runner.ts work",
    "dev:raw": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "smoke": "bash scripts/smoke.sh",
    "smoke:dev": "bash scripts/smoke.sh --start-server",
    "cli": "node scripts/lodesta.mjs",
    "access:platform-admin": "node --env-file=.env.local --import tsx scripts/manage-platform-admin.ts",
    "access:external-authoring": "node --env-file=.env.local --import tsx scripts/manage-external-authoring-credentials.ts",
    "cutover:external-authoring-previews": "node --env-file=.env.local --import tsx scripts/cutover-external-authoring-previews.ts",
    "worker": "node --import tsx workers/runner.ts",
    "runtime:promote": "node --env-file=.env.local --import tsx scripts/promote-site-runtime.ts",
    "audit:artifact-blobs": "node --env-file=.env.local --import tsx scripts/audit-artifact-blobs.ts",
    "audit:sandbox-cost": "node --env-file=.env.local --import tsx scripts/audit-sandbox-cost.ts",
    "configure:r2-lifecycle": "node --env-file=.env.local --import tsx scripts/configure-r2-lifecycle.ts",
    "deploy:artifact-broker": "wrangler deploy --config workers/artifact-broker/wrangler.jsonc",
    "deploy:recovery-watchdog": "wrangler deploy --config workers/recovery-watchdog/wrangler.jsonc",
    "deploy:site-sandbox": "wrangler deploy --config workers/site-sandbox/wrangler.jsonc",
    "maintenance:site-authoring": "node --env-file=.env.local --import tsx scripts/site-authoring-maintenance.ts",
    "maintenance:reset-prelaunch-site-authoring": "node --env-file=.env.local --import tsx scripts/reset-prelaunch-site-authoring.ts",
    "install:browsers": "node --import tsx scripts/install-browsers.ts",
    "verify:deployment-config": "node --import tsx scripts/verify-deployment-config.ts",
    "verify:recovery-watchdog": "node --import tsx scripts/verify-recovery-watchdog.ts",
    "verify:dev-crawl": "node --import tsx scripts/verify-dev-crawl.mjs",
    "verify:business-data-normalization": "node --import tsx scripts/verify-business-data-normalization.ts",
    "verify:architecture": "node --import tsx scripts/verify-site-authoring-architecture.ts",
    "verify:database": "node --import tsx scripts/verify-supabase.ts",
    "verify:authoring": "node --import tsx scripts/verify-site-authoring-platform.ts && node --import tsx scripts/verify-authority-flows.ts",
    "verify:external-authoring": "LODESTA_REPOSITORY=local node --import tsx scripts/verify-external-authoring.ts",
    "verify:external-authoring-connectivity": "node --env-file=.env.local --import tsx scripts/spike-external-authoring-connectivity.ts",
    "verify:runtime": "node --import tsx scripts/verify-trusted-runtime.ts && node --import tsx scripts/verify-artifact-storage-boundaries.ts",
    "verify:account-setup-domain": "node --import tsx scripts/verify-account-access.ts && node --import tsx scripts/verify-owner-workspace.ts && node --import tsx scripts/verify-website-setups.ts && node --import tsx scripts/verify-site-disposition.ts",
    "verify:acquisition": "node --import tsx scripts/verify-prospect-reports.ts",
    "verify:website-assessments": "node --import tsx scripts/verify-website-assessments.ts",
    "calibrate:website-assessments": "node --import tsx scripts/calibrate-website-assessments.ts",
    "verify:generation-ingestion": "node --import tsx scripts/verify-generation-ingestion.ts",
    "verify:artifact-storage-boundaries": "node --import tsx scripts/verify-artifact-storage-boundaries.ts",
    "verify:r2-maintenance-access": "node --env-file=.env.local --import tsx scripts/verify-r2-maintenance-access.ts",
    "verify:r2-lifecycle": "node --env-file=.env.local --import tsx scripts/verify-r2-lifecycle.ts",
    "verify:render-browser": "node --import tsx scripts/verify-site-authoring-render-browser.ts",
    "verify:retained-site": "node --env-file=.env.local --import tsx scripts/verify-retained-site.ts",
    "verify:site-sandbox-local": "node --import tsx scripts/verify-site-sandbox-local.ts",
    "verify:site-agent-manager": "node --import tsx scripts/verify-site-agent-manager.ts",
    "verify:media-authoring": "node --import tsx scripts/verify-media-authoring.ts",
    "verify:site-intent-persistence": "node --import tsx scripts/verify-site-intent-persistence.ts",
    "verify:site-agent-workspace": "node --import tsx scripts/verify-site-agent-workspace.ts",
    "verify:product-ui": "node --import tsx scripts/verify-product-ui.ts",
    "verify:product-typography": "node --import tsx scripts/verify-product-typography.ts",
    "verify:trusted-runtime": "node --import tsx scripts/verify-trusted-runtime.ts",
    "verify:analytics": "node --import tsx scripts/verify-analytics.ts",
    "maintenance:analytics-retention": "node --env-file=.env.local --import tsx scripts/prune-analytics-events.ts",
    "verify:agent-ready-sites": "node --import tsx scripts/verify-agent-ready-sites.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@cloudflare/sandbox": "^0.12.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "axe-core": "^4.12.1",
    "htmlparser2": "^12.0.0",
    "next": "^15.5.21",
    "openai": "^6.48.0",
    "playwright": "^1.60.0",
    "postcss": "8.5.15",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "postcss": "8.5.15",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "wrangler": "^4.112.0"
  }
}
