{
  "name": "lodesta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p ${PORT:-4330} -H ${HOST:-127.0.0.1}",
    "dev:worker": "node --import tsx workers/runner.ts work",
    "dev:raw": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "smoke": "bash scripts/smoke.sh",
    "smoke:dev": "bash scripts/smoke.sh --start-server",
    "cli": "node scripts/lodesta.mjs",
    "benchmark:austin-auto": "node --import tsx scripts/run-market-benchmark.ts",
    "seed:openai-settings": "node --import tsx scripts/seed-openai-settings.ts",
    "worker": "node --import tsx workers/runner.ts",
    "install:browsers": "node --import tsx scripts/install-browsers.ts",
    "verify:worker-runtime": "node --import tsx scripts/verify-worker-runtime.mjs",
    "verify:job-heartbeat": "node --import tsx --import ./scripts/load-env.ts scripts/verify-job-heartbeat.ts",
    "verify:deployment-config": "node --import tsx scripts/verify-deployment-config.ts",
    "verify:launch-boundaries": "node --import tsx scripts/verify-launch-boundaries.ts",
    "verify:dev-crawl": "node --import tsx scripts/verify-dev-crawl.mjs",
    "verify:market-benchmark-fixtures": "node --import tsx scripts/verify-market-benchmark-fixtures.ts",
    "verify:evidence-manifest": "node --import tsx scripts/verify-generation-evidence-manifest.ts",
    "verify:canonical-generation": "node --import tsx scripts/verify-canonical-generation.ts",
    "freeze:generation-inputs": "node --import tsx scripts/freeze-generation-inputs.ts",
    "verify:control-plane": "node --import tsx scripts/verify-control-plane.tsx",
    "verify:canonical-render-browser": "node --import tsx scripts/verify-canonical-render-browser.ts",
    "verify:render-browser": "node --import tsx scripts/verify-canonical-render-browser.ts",
    "verify:generation-judge": "node --import tsx scripts/verify-generation-judge.ts",
    "verify:generation-pipeline": "node --import tsx scripts/verify-generation-pipeline.ts",
    "verify:generation-architecture": "node --import tsx scripts/verify-generation-architecture.ts",
    "report:generation-stored-data": "node --import tsx --import ./scripts/load-env.ts scripts/report-generation-stored-data.ts",
    "cleanup:generation-precutover": "node --import tsx --import ./scripts/load-env.ts scripts/cleanup-generation-precutover.ts",
    "verify:prospect-reports": "node --import tsx scripts/verify-prospect-reports.ts",
    "verify:stripe-webhook": "node --import tsx scripts/verify-stripe-webhook.ts",
    "verify:supabase": "node --import tsx scripts/verify-supabase.ts",
    "pilot:auto-body": "node --env-file=.env.local --import tsx scripts/run-benchmark-vector.ts",
    "pilot:auto-body:preflight": "node --import tsx scripts/preflight-benchmark-targets.ts --targets-file config/benchmark-targets/auto-body-pilot.txt --expected-vertical auto_body --report .data/benchmarks/canonical-auto-body-pilot-preflight.json",
    "model:launch-capacity": "node --import tsx scripts/launch-capacity-model.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "htmlparser2": "^12.0.0",
    "next": "^15.0.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
